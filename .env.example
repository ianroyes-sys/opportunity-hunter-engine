# Workspace holding pipeline/ and profile/ (default: repo root)
OPPORTUNITY_ROOT=
# Loop-runner state dir: loops/state, loops/answers, loops/receipts (default: <repo>/.runner)
OPPORTUNITY_RUNNER_DIR=
# Name shown in the dashboard header
OPPORTUNITY_OWNER=
# Path to the Google Workspace CLI used by scripts/send_email.py (default: ~/.local/bin/gws)
GWS_BIN=
# Claude Code permission mode for scripts/run_lane.sh (default: acceptEdits)
CLAUDE_PERMISSION_MODE=
